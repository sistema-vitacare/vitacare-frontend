# Cabeçalhos de segurança, incluídos pelo server e por cada location do
# default.conf. Extensão .inc: fica fora do `include conf.d/*.conf` do http.
#
# Acesso por http://IP, sem HTTPS (decisão de 2026-11-10): HSTS,
# upgrade-insecure-requests e Cross-Origin-Opener-Policy ficam de fora porque
# o navegador os ignora ou quebraria o acesso fora de contexto seguro.
#
# CSP: o Emotion (MUI) injeta <style> em tempo de execução, daí
# 'unsafe-inline' só em style-src; nenhum script inline é permitido. O
# connect-src libera apenas a própria origem e a API_URL da stack.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${API_URL}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
# O token de redefinição de senha vem na URL: nenhum Referer sai da página.
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Resource-Policy "same-origin" always;
